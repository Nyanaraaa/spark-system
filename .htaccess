# BEGIN Basic Configuration
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Exclude index.php from being rewritten
RewriteRule ^index\.php$ - [L]

# Allow directory listing for non-PHP files and directories
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.* - [L]

# Rewrite non-existing files and directories to index.php (but allow direct access to existing PHP files)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /spark/index.php [L]
</IfModule>
# END Basic Configuration

# Enable Directory Listing
Options +Indexes
